# Copia este archivo como .env y completa tus propios valores.
# El archivo .env NO se sube al repositorio (está en .gitignore).
# En Vercel, estas mismas variables se configuran en el panel del proyecto.

ADMIN_CORREO=admin@academia.cr
ADMIN_CLAVE=cambia-esta-clave

USUARIO_CORREO=usuario@academia.cr
USUARIO_CLAVE=cambia-esta-clave

# Clave para firmar la cookie de sesión. Usa un texto largo y aleatorio.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
